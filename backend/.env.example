# 数据库连接（默认 backend/lumo.db）
DATABASE_URL=sqlite+aiosqlite:///./backend/lumo.db
# 后端端口
PORT=8000
# API Key 加密主密钥（64 位 hex，留空则首次启动自动生成并写入 .env）
MASTER_KEY=
# 允许私网 SearXNG 地址（自建实例常部署在 127.0.0.1；默认 false 拒绝私网）
ALLOW_PRIVATE_SEARXNG=false
# 多用户鉴权总开关（默认 false：单用户模式，所有请求归属 DEFAULT_USER_ID，本机行为零变化）
AUTH_ENABLED=false
# 单用户模式下的默认用户 ID
DEFAULT_USER_ID=local
# JWT 有效期（天）
JWT_EXPIRE_DAYS=30
# CORS 允许的来源，逗号分隔多源（如 http://localhost:5173,https://example.com）
CORS_ORIGINS=http://localhost:5173
