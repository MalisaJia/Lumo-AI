{
  "name": "lumo-ai",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,green \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "backend\\.venv\\Scripts\\python.exe -m uvicorn app.main:app --reload --port 8000 --app-dir backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "build:desktop": "powershell -ExecutionPolicy Bypass -File scripts/build-desktop.ps1"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
